# Base URL for Backend REST API
# For local development with Vite proxy: /api
# For production deployment (e.g., Vercel pointing to Render backend):
# VITE_API_BASE_URL=https://jobtracker-backend.onrender.com/api
VITE_API_BASE_URL=/api
