# ===================================================================
# JobTracker Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to '.env' (for local development) or set these
#    variables in your production environment/container orchestrator.
# 2. Replace placeholder values with your real configuration.
# 3. NEVER commit the actual '.env' file or production secrets to Git.
# ===================================================================

# Spring Profile ('dev' for local development, 'prod' for production)
SPRING_PROFILES_ACTIVE=dev

# Server Port (default: 8080)
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_HOST_PORT=3307
DB_NAME=jobtracker
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password
DB_ROOT_PASSWORD=your_secure_root_password

# HikariCP Connection Pool (Production Profile)
DB_POOL_MAX=10
DB_POOL_MIN=5

# JWT Authentication Configuration
# JWT_SECRET must be at least 256 bits (32 bytes), represented as 64 hex characters.
# Generate one using: openssl rand -hex 32
JWT_SECRET=your_256_bit_jwt_secret_key_here_minimum_64_hex_chars
# Expiration in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# CORS Allowed Origins (comma-separated list of allowed frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
