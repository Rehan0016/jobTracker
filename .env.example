# ===================================================================
# JobTracker Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to '.env' (for local development) or set these
#    variables in your production environment/container orchestrator (e.g. Render).
# 2. Replace placeholder values with your real configuration.
# 3. NEVER commit the actual '.env' file or production secrets to Git.
# ===================================================================

# Spring Profile ('dev' for local development, 'prod' for production)
SPRING_PROFILES_ACTIVE=prod

# Server Port (default: 8080, automatically assigned by Render via PORT)
SERVER_PORT=8080

# Database Configuration (Supabase PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.hmeufaqxjfjgjjcipsee
SPRING_DATASOURCE_PASSWORD=database_password

# HikariCP Connection Pool (Production Profile)
DB_POOL_MAX=5
DB_POOL_MIN=1

# Hibernate DDL Auto ('update' creates/updates tables on fresh Supabase DB, 'validate' for strict schema)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Authentication Configuration
# JWT_SECRET must be at least 256 bits (32 bytes), represented as 64 hex characters.
# Generate one using: openssl rand -hex 32
JWT_SECRET=your_256_bit_jwt_secret_key_here_minimum_64_hex_chars
# Expiration in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# CORS Allowed Origins (comma-separated list of allowed frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.onrender.com
